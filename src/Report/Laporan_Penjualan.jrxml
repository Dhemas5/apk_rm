    <parameter name="tanggal" class="java.util.Date" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <queryString language="SQL">
		<![CDATA[SELECT 
            tr.ID_Transaksi AS ID_Transaksi, 
            tr.Tanggal_Transaksi AS Tanggal_Transaksi, 
            p.Nama_Pelanggan AS Nama_Pelanggan, 
            tr.Total AS Total, 
            u.Nama_User AS Nama_User, 
            m.Nomor_Meja AS Nomor_Meja
        FROM 
            tbl_transaksi tr
            INNER JOIN tbl_pelanggan p ON tr.ID_Pelanggan = p.ID_Pelanggan
            INNER JOIN tbl_user u ON tr.ID_User = u.ID_User
            INNER JOIN tbl_meja m ON tr.ID_Meja = m.ID_Meja
        WHERE DATE(tr.Tanggal_Transaksi) = DATE($P{tanggal})
        ORDER BY 
            tr.Tanggal_Transaksi DESC]]>
    </queryString>
    <field name="ID_Transaksi" class="java.lang.Integer">
