	<parameter name="ID_Transaksi" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT tr.ID_Transaksi,
plg.Nama_Pelanggan,
tr.Tanggal_Transaksi,
usr.Nama_User,
mj.Nomor_Meja,
mn.Nama_Menu,
mn.Harga, det.Jumlah_Beli,
det.Sub_Total,
tr.Total,
tr.Bayar,
tr.Kembalian
FROM tbl_transaksi tr
INNER JOIN tbl_detail_transaksi det ON det.ID_Transaksi = tr.ID_Transaksi
INNER JOIN tbl_pelanggan plg ON plg.ID_Pelanggan = tr.ID_Pelanggan
INNER JOIN tbl_user usr ON usr.ID_User = tr.ID_User
INNER JOIN tbl_meja mj ON mj.ID_Meja = tr.ID_Meja
INNER JOIN tbl_menu mn ON mn.ID_Menu = det.ID_Menu
WHERE tr.ID_Transaksi = $P{ID_Transaksi}]]>
	</queryString>
